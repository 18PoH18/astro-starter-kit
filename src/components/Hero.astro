---
// src/components/Hero.astro
import { site } from '../config/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-media">
    <img
      src={site.hero.image}
      alt=""
      class="hero-image"
      loading="eager"
      width="1200"
      height="600"
    />
    <div class="hero-overlay" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <h1 id="hero-heading" class="hero-headline">{site.hero.headline}</h1>
    {site.hero.subheadline && (
      <p class="hero-subheadline">{site.hero.subheadline}</p>
    )}
    {site.hero.cta && (
      <a
        href={site.hero.cta.url}
        class="hero-cta"
      >
        {site.hero.cta.label}
      </a>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 60vh;
    min-height: 60dvh;
    overflow: hidden;
    background: var(--color-primary);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, rgba(0,0,0,0.15) 0%, transparent 60%),
      color-mix(in srgb, rgba(0,0,0,0.55) 100%, rgba(0,0,0,0.3) 100%)
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 36rem;
    padding: 0 1.5rem;
    margin-top: 8rem;
    color: #fff;
  }

  .hero-headline {
    font-family: var(--font-display), serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .hero-subheadline {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
    opacity: 0.9;
    margin: 0 0 2rem;
    max-width: 24rem;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    transition: transform 0.15s ease, background 0.15s ease;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .hero-cta:hover {
    background: color-mix(in srgb, var(--color-accent) 85%, #000);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 50vh;
      min-height: 50dvh;
    }

    .hero-content {
      margin-top: 4rem;
    }
  }
</style>
