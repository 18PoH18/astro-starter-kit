---
// src/components/Pricing.astro
import { site } from '../config/site';
---

<section class="pricing" aria-labelledby="pricing-heading">
  <div class="container">
    <header class="section-header">
      <span class="section-eyebrow">How We Work</span>
      <h2 id="pricing-heading" class="section-title">Our Pricing</h2>
      <p class="section-sub">
        Starting prices below. Every project is a fixed fee, scoped after our first conversation — no hourly billing, no surprise invoices halfway through.
      </p>
    </header>

    <ul class="pricing-grid" role="list">
      <li class="pricing-card">
        <div class="pricing-content">
          <h3 class="pricing-title">Brand Identity</h3>
          <p class="pricing-description">
            Names, wordmarks, logos, colour systems, and the visual language a brand needs across every surface — print, web, social, and packaging.
          </p>
          <ul class="pricing-list">
            <li>Identity discovery & positioning</li>
            <li>Wordmark + logotype</li>
            <li>Colour system & type scale</li>
            <li>Usage guidelines</li>
            <li>Files for web, print, and brand partners</li>
          </ul>
          <p class="pricing-price">From £4,500</p>
        </div>
      </li>

      <li class="pricing-card">
        <div class="pricing-content">
          <h3 class="pricing-title">Digital Products</h3>
          <p class="pricing-description">
            Product interfaces, dashboards, and tools — designed to be clear first and attractive second. We care about how something works long before we care about how it looks.
          </p>
          <ul class="pricing-list">
            <li>UX discovery & task mapping</li>
            <li>Wireframes & user flows</li>
            <li>High-fidelity UI design</li>
            <li>Interactive prototype (optional)</li>
            <li>Developer-ready specs & assets</li>
          </ul>
          <p class="pricing-price">From £6,000</p>
        </div>
      </li>

      <li class="pricing-card featured">
        <div class="pricing-content">
          <span class="pricing-badge">Most common</span>
          <h3 class="pricing-title">Web & Marketing Sites</h3>
          <p class="pricing-description">
            Fast, clean websites built on a config-driven Astro kit — no bloat, no framework overhead, no surprises at launch. One config file, a real deploy, and a site that actually loads.
          </p>
          <ul class="pricing-list">
            <li>Up to 5 pages, content-ready</li>
            <li>Mobile-first responsive build</li>
            <li>Contact form (Formspree)</li>
            <li>SEO basics: meta, OG, sitemap</li>
            <li>Analytics setup (Plausible or GA4)</li>
            <li>1 round of revisions after launch</li>
          </ul>
          <p class="pricing-price">From £2,000</p>
        </div>
      </li>

      <li class="pricing-card">
        <div class="pricing-content">
          <h3 class="pricing-title">Design Systems</h3>
          <p class="pricing-description">
            Component libraries, token systems, and the rules that keep a growing product from drifting into inconsistency. Built so the next person who touches it can move fast without breaking things.
          </p>
          <ul class="pricing-list">
            <li>Design tokens (colour, type, space)</li>
            <li>Component library (Figma)</li>
            <li>Component docs & usage rules</li>
            <li>Integration guide for developers</li>
            <li>Handover session with your team</li>
          </ul>
          <p class="pricing-price">From £5,000</p>
        </div>
      </li>
    </ul>

    <div class="pricing-note">
      <p>
        Every project starts with a short scoping call — usually 30 minutes, no charge. We'll talk about what you need, what you don't, and roughly where this sits relative to the starting prices above. After that, you'll get a fixed-fee proposal within two working days.
      </p>
      <p>
        Need something that's not listed here? We take on smaller scoped pieces — a logo refresh, a one-page site, a landing page — and we can talk about those on the same call.
      </p>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: 5rem 0;
    background: var(--color-surface);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-display), serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.2;
    color: var(--color-text);
  }

  .section-sub {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0.75rem 0 0;
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
  }

  .pricing-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 1.75rem;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    border-radius: 0.75rem;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .pricing-card:hover {
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-text) 12%, transparent);
    transform: translateY(-2px);
  }

  .pricing-card.featured {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .pricing-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .pricing-content {
    flex: 1;
  }

  .pricing-title {
    font-family: var(--font-display), serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .pricing-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .pricing-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .pricing-list li {
    font-size: 0.875rem;
    color: var(--color-text);
    padding-left: 1.25rem;
    position: relative;
    line-height: 1.5;
  }

  .pricing-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .pricing-price {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    letter-spacing: -0.01em;
  }

  .pricing-note {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
    border-radius: 0.75rem;
  }

  .pricing-note p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0 0 0.75rem;
  }

  .pricing-note p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 640px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pricing-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
