---
// src/pages/contact.astro
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Map from '../components/Map.astro';
import { site } from '../config/site';
---

<Base title="Contact">
  <div class="page-hero">
    <div class="container">
      <span class="page-eyebrow">Get in Touch</span>
      <h1 class="page-title">Contact Øxis</h1>
      <p class="page-description">
        Have a project in mind? Send us a message and we'll get back to you.
      </p>
    </div>
  </div>

  <div class="contact-layout">
    <div class="container">
      <div class="contact-grid">
        <section class="contact-info" aria-labelledby="contact-info-heading">
          <h2 id="contact-info-heading" class="info-section-title">Contact</h2>

          <address class="contact-address">
            <p class="address-line">{site.address || '—'}</p>
            <p class="contact-link-line">
              <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="contact-link">
                {site.phone || '—'}
              </a>
            </p>
            <p class="contact-link-line">
              <a href={`mailto:${site.email}`} class="contact-link">
                {site.email || '—'}
              </a>
            </p>
          </address>

          <div class="hours-block">
            <h3 class="hours-heading">Hours</h3>
            <ul class="hours-list">
              {site.hours && Object.entries(site.hours).map(([day, hours]) => (
                <li>
                  <span class="day">{day.charAt(0).toUpperCase() + day.slice(1)}</span>
                  <span class="hours">{hours}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="contact-form-section">
          <ContactForm />
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .page-hero {
    background: var(--color-primary);
    color: #fff;
    padding: 5rem 0;
    text-align: center;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-family: var(--font-display), serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .page-description {
    font-size: 1.0625rem;
    line-height: 1.65;
    opacity: 0.85;
    margin: 0;
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
  }

  .contact-layout {
    padding: 5rem 0;
    background: var(--color-surface);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 2rem;
  }

  .info-section-title {
    font-family: var(--font-display), serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1.5rem;
    color: var(--color-text);
  }

  .contact-address {
    font-style: normal;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .address-line {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }

  .contact-link-line {
    margin: 0;
  }

  .contact-link {
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: none;
    transition: text-decoration 0.15s ease;
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .hours-block {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  .hours-heading {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .hours-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem 1rem;
  }

  .hours-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .day {
    font-weight: 500;
  }

  .hours {
    color: var(--color-muted);
    text-align: right;
  }

  .contact-form-section {
    display: flex;
    flex-direction: column;
  }

  @media (width >= 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: 4rem;
    }

    .hours-list {
      grid-template-columns: repeat(7, 1fr);
    }
  }
</style>
