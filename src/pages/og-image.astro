---
// src/pages/og-image.astro
// Generates an Open Graph image (1200×630) for social sharing.
// Renders as an image rather than HTML — set output: 'image' on the page.
export const prerender = true;
import { site } from '../config/site';
---

<!-- This page is intended to be rendered as an image via Astro's image
     endpoint or a static og-image.png in public/. For the kit, we ship a
     static SVG-based og-image.png placeholder in public/ and let clients
     replace it per site. -->

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>{site.businessName} — Open Graph Image</title>
  </head>
  <body>
    <p>
      To replace this, drop a <code>public/og-image.png</code> (1200×630) per client.
      The <code>Base.astro</code> layout already references <code>/og-image.png</code>
      in the OG meta tags.
    </p>
  </body>
</html>
