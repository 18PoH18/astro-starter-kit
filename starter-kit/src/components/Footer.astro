---
// src/components/Footer.astro
import { site } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="brand-text">{site.businessName}</span>
        <p class="footer-tagline">{site.tagline}</p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <div class="footer-contact">
        <h3 class="footer-section-title">Get in Touch</h3>
        <address class="footer-address">
          <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="footer-link">
            {site.phone}
          </a>
          <br />
          <a href={`mailto:${site.email}`} class="footer-link">
            {site.email}
          </a>
          <br />
          <span>{site.address}</span>
        </address>

        <nav class="footer-social" aria-label="Social media">
          {site.social.instagram && (
            <a
              href={site.social.instagram}
              class="social-icon"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          )}
          {site.social.facebook && (
            <a
              href={site.social.facebook}
              class="social-icon"
              aria-label="Facebook"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
          )}
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} {site.businessName}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: rgba(255, 255, 255, 0.85);
    padding: 4rem 0 2rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .brand-text {
    display: block;
    font-family: var(--font-display), serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    margin: 0;
    font-size: 0.9375rem;
    opacity: 0.75;
    line-height: 1.5;
    max-width: 16rem;
  }

  .footer-nav .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
  }

  .footer-nav a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.15s ease;
  }

  .footer-nav a:hover {
    color: #fff;
  }

  .footer-section-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 1rem;
  }

  .footer-address {
    font-style: normal;
    line-height: 1.7;
    font-size: 0.9375rem;
    margin: 0 0 1.25rem;
  }

  .footer-link {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: #fff;
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .social-icon:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 1.5rem;
  }

  .footer-copy {
    margin: 0;
    font-size: 0.8125rem;
    opacity: 0.6;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 2fr;
      gap: 3rem;
    }
  }
</style>
