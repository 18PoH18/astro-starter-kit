---
// src/components/Testimonials.astro
import { site } from '../config/site';
---

{site.showTestimonials === true && site.testimonials && site.testimonials.length > 0 && (
  <section class="testimonials" aria-labelledby="testimonials-heading">
    <div class="container">
      <header class="section-header">
        <span class="section-eyebrow">Kind Words</span>
        <h2 id="testimonials-heading" class="section-title">What People Say</h2>
      </header>

      <ul class="testimonials-grid" role="list" aria-label="Customer testimonials">
        {site.testimonials.map((t) => (
          <li class="testimonial-card">
            <blockquote class="testimonial-quote">
              <p class="testimonial-text">{t.quote}</p>
            </blockquote>
            <footer class="testimonial-author">
              <cite class="testimonial-name">{t.author}</cite>
              {t.role && <span class="testimonial-role">{t.role}</span>}
            </footer>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .testimonials {
    padding: 5rem 0;
    background: var(--color-surface);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-display), serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.2;
  }

  .testimonials-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .testimonial-card {
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
    border-radius: 0.75rem;
    padding: 1.75rem;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .testimonial-quote {
    margin: 0 0 1rem;
    padding: 0;
  }

  .testimonial-text {
    font-family: var(--font-display), serif;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-text);
    margin: 0;
    position: relative;
    padding-left: 1.5rem;
  }

  .testimonial-text::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.125rem;
    bottom: 0.125rem;
    width: 3px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .testimonial-author {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .testimonial-name {
    font-weight: 600;
    font-style: normal;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .testimonial-role {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (min-width: 640px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
